    "        elif assign_tier(node) == 2:\n",
    "            node_colors.append(\"skyblue\")\n",
    "        elif assign_tier(node) == 3:\n",
    "            node_colors.append(\"plum\")\n",
    "        else:\n",
    "            node_colors.append(\"lightgray\")\n",
    "\n",
    "    plt.figure(figsize=(18, 10))\n",
    "\n",
    "    nx.draw_networkx_edges(\n",
    "        G,\n",
    "        pos,\n",
    "        arrows=True,\n",
