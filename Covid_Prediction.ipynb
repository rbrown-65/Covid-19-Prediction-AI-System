  "# =========================================================\n",
  "# PART Q - AT-HOME COVID-19 SCREENING AI SYSTEM\n",
  "# =========================================================\n",
  "# This section turns the trained model into a simple at-home screening system.\n",
  "# It uses information that could reasonably be known before a clinic or ER visit.\n",
  "# The output is a screening-support estimate, not a replacement for PCR testing.\n",
  "\n",
  "# Select the model with the highest AUC\n",
  "best_model_name = results_df.iloc[0][\"Model\"]\n",
  "best_model = fitted_models[best_model_name]\n",
  "\n",
  "print(\"Best model selected:\", best_model_name)\n",
  "\n",
  "\n",
  "def assign_risk_category(probability):\n",
  "    if probability < 0.30:\n",
  "        return \"Low\"\n",
  "    elif probability < 0.60:\n",
  "        return \"Moderate\"\n",
  "    else:\n",
  "        return \"High\"\n",
  "\n",
  "\n",
  "def build_home_case(input_dict):\n",
  "    case_row = pd.DataFrame(0, index=[0], columns=X.columns)\n",
  "\n",
  "    # Set available home-input variables\n",
  "    for variable, value in input_dict.items():\n",
  "        if variable in case_row.columns:\n",
  "            case_row.loc[0, variable] = value\n",
  "\n",
  "    # Recreate interaction terms from the selected home-input variables\n",
  "    for col in case_row.columns:\n",
  "        if \"__X__\" in col:\n",
  "            parts = col.split(\"__X__\")\n",
  "\n",
  "            if all(part in case_row.columns for part in parts):\n",
  "                product_value = 1\n",
  "\n",
  "                for part in parts:\n",
  "                    product_value = product_value * case_row.loc[0, part]\n",
  "\n",
  "                case_row.loc[0, col] = product_value\n",
  "\n",
  "    return case_row\n",
  "\n",
  "\n",
  "def predict_home_covid_risk(input_dict):\n",
  "    case_row = build_home_case(input_dict)\n",
  "    probability = best_model.predict_proba(case_row)[0, 1]\n",
  "    risk_category = assign_risk_category(probability)\n",
  "\n",
  "    return probability, risk_category, case_row\n",
  "\n",
  "\n",
  "# Example at-home patient scenario\n",
  "# These are coded COVIDCARE variables that represent information available at home.\n",
  "home_patient_input = {\n",
  "    \"30158-Symtpom_Neuro-7\": 1,\n",
  "    \"30158-Symtpom_Neuro-8\": 1,\n",
  "    \"30141-covid_tst_symptoms-3\": 1,\n",
  "    \"30766-pinkblue_confirm\": 1\n",
  "}\n",
  "\n",
  "home_probability, home_risk_category, home_case_row = predict_home_covid_risk(home_patient_input)\n",
  "\n",
  "print(\"AT-HOME COVID-19 SCREENING RESULT\")\n",
  "print(\"Best model used:\", best_model_name)\n",
  "print(\"Predicted probability of PCR-positive COVID-19:\", round(home_probability, 4))\n",
  "print(\"Risk category:\", home_risk_category)\n",
  "\n",
  "if home_risk_category == \"Low\":\n",
  "    recommendation = \"Low screening risk. Continue monitoring symptoms and follow public health guidance.\"\n",
  "elif home_risk_category == \"Moderate\":\n",
  "    recommendation = \"Moderate screening risk. Consider confirmatory testing and monitor symptoms closely.\"\n",
  "else:\n",
  "    recommendation = \"High screening risk. Seek confirmatory testing or clinical guidance, especially if symptoms worsen.\"\n",
  "\n",
  "print(\"Recommendation:\", recommendation)\n",
  "print(\"\\nImportant: This is a screening-support estimate, not a definitive diagnosis.\")\n",
  "print(\"PCR or other clinically accepted testing remains the diagnostic standard.\")\n"
  ]
