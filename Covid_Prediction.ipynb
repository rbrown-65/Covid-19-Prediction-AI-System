 "outputs": [],
 "source": [
  "# ---------------------------------------------------------\n",
  "# 12. KEEP ONLY HOME-AVAILABLE VARIABLES THAT PRECEDE PCR\n",
  "# ---------------------------------------------------------\n",
  "# The assignment goal is to diagnose/screen for COVID-19 using information\n",
  "# available at home before a clinic or emergency room visit.\n",
  "#\n",
  "# Keep:\n",
  "# - demographics\n",
  "# - vaccination information\n",
  "# - self-reported symptoms\n",
  "# - exposure/illness history\n",
  "# - at-home test information\n",
  "#\n",
  "# Exclude:\n",
  "# - PCR/lab outcome variables\n",
  "# - clinic/emergency/hospital variables\n",
  "# - post-diagnosis or formal result variables that would not be known at home\n",
  "\n",
  "def is_home_available_predictor(col):\n",
  "    c = str(col).lower()\n",
  "\n",
  "    # Never include the outcome itself\n",
  "    if col == TARGET:\n",
  "        return False\n",
  "\n",
  "    # Only use variables before PCR confirmation\n",
  "    if assign_tier(col) >= 4:\n",
  "        return False\n",
  "\n",
  "    # Exclude likely clinic/lab/post-visit/result variables\n",
  "    exclude_terms = [\n",
  "        \"pcr\",\n",
  "        \"lab\",\n",
  "        \"laboratory\",\n",
  "        \"clinic\",\n",
  "        \"emergency\",\n",
  "        \"er\",\n",
  "        \"hospital\",\n",
  "        \"provider\",\n",
  "        \"doctor\",\n",
  "        \"physician\",\n",
  "        \"medical_record\",\n",
  "        \"covid_results\"\n",
  "    ]\n",
  "\n",
  "    # Keep at-home test line/confirmation fields even though they are test-related\n",
  "    home_test_terms = [\n",
  "        \"pinkblue\",\n",
  "        \"blue_nopink\",\n",
  "        \"noblue\",\n",
  "        \"pinkline\",\n",
  "        \"blueline\",\n",
  "        \"athome\",\n",
  "        \"testkit\",\n",
  "        \"home\"\n",
  "    ]\n",
  "\n",
  "    if any(term in c for term in home_test_terms):\n",
  "        return True\n",
  "\n",
  "    if any(term in c for term in exclude_terms):\n",
  "        return False\n",
  "\n",
  "    return True\n",
  "\n",
  "\n",
  "predictor_cols = [\n",
  "    c for c in model_df.columns\n",
  "    if is_home_available_predictor(c)\n",
  "]\n",
  "\n",
  "X_base = model_df[predictor_cols].copy()\n",
  "y = model_df[TARGET].copy()\n",
  "\n",
  "print(\"Home-available predictor matrix shape:\", X_base.shape)\n",
  "print(\"Target vector shape:\", y.shape)\n",
  "print(\"Number of PCR-positive cases:\", y.sum())\n",
  "print(\"Number of PCR-negative cases:\", len(y) - y.sum())\n",
  "\n",
  "print(\"\\nExamples of home-available predictors:\")\n",
  "print(predictor_cols[:20])\n",
  "\n",
  "# Check that likely leakage/result variables were excluded\n",
  "excluded_check = [\n",
  "    c for c in model_df.columns\n",
  "    if c not in predictor_cols and c != TARGET\n",
  "]\n",
  "\n",
  "print(\"\\nNumber of excluded non-target variables:\", len(excluded_check))\n",
  "\n",
  "# =========================================================\n",
  "# PART F - PAIRWISE OR TRIPLE CLUSTERS OF VARIABLES\n",
  "# =========================================================\n"
 ]
},
