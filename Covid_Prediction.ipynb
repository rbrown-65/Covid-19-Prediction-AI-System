    "# =========================================================\n",
    "# PART O - DRAW NETWORK\n",
    "# =========================================================\n",
    "\n",
    "import textwrap\n",
    "\n",
    "def clean_name(name):\n",
    "    name = str(name)\n",
    "\n",
    "    if name == TARGET:\n",
    "        return \"PCR\\nPositive\"\n",
    "\n",
    "    if \"30158-Symtpom_Neuro-7\" in name:\n",
    "        return \"Neuro\\nSymptom 7\"\n",
    "\n",
    "    if \"30158-Symtpom_Neuro-8\" in name:\n",
    "        return \"Neuro\\nSymptom 8\"\n",
    "\n",
    "    if \"pinkblue\" in name:\n",
    "        return \"Home Test\\nPositive\"\n",
    "\n",
    "    if \"blue_nopink\" in name:\n",
    "        return \"Home Test\\nNegative\"\n",
    "\n",
    "    if \"noblue\" in name:\n",
    "        return \"No Test\\nLine\"\n",
    "\n",
    "    if \"covid_results-1\" in name:\n",
    "        return \"COVID\\nResult 1\"\n",
    "\n",
    "    if \"covid_results-2\" in name:\n",
    "        return \"COVID\\nResult 2\"\n",
    "\n",
    "    if \"states_specify\" in name:\n",
    "        return \"State\\nIndicator\"\n",
    "\n",
    "    if \"vaccine_avail\" in name:\n",
    "        return \"Vaccine\\nAvailable\"\n",
    "\n",
    "    if \"vaccine_factors\" in name:\n",
    "        return \"Vaccine\\nFactor\"\n",
    "\n",
    "    if \"covid_tst_symptoms\" in name:\n",
    "        return \"Symptom\\n\" + name.split(\"-\")[-1]\n",
    "\n",
    "    if \"join_hear\" in name:\n",
    "        return \"Survey\\nSource\"\n",
    "\n",
    "    short = (\n",
    "        name.replace(\"30141-\", \"\")\n",
    "            .replace(\"covid_\", \"\")\n",
    "            .replace(\"tst_\", \"\")\n",
    "            .replace(\"_\", \" \")\n",
    "    )\n",
    "\n",
    "    return \"\\n\".join(textwrap.wrap(short[:24], width=12))\n",
    "\n",
    "\n",
    "def tier_layout(graph):\n",
    "    pos = {}\n",
    "\n",
    "    tier_nodes = {}\n",
    "    for node in graph.nodes():\n",
    "        tier = assign_tier(node)\n",
    "        tier_nodes.setdefault(tier, []).append(node)\n",
    "\n",
    "    # Manually space tiers left to right\n",
    "    x_positions = {\n",
    "        0: 0,\n",
    "        1: 4,\n",
    "        2: 8,\n",
    "        3: 12,\n",
    "        4: 16\n",
    "    }\n",
    "\n",
    "    for tier, nodes in tier_nodes.items():\n",
    "        nodes = sorted(nodes)\n",
    "        n = len(nodes)\n",
    "\n",
    "        if n == 1:\n",
    "            y_positions = [0]\n",
    "        else:\n",
    "            y_positions = np.linspace(5, -5, n)\n",
    "\n",
    "        for node, y in zip(nodes, y_positions):\n",
    "            pos[node] = (x_positions.get(tier, tier * 4), y)\n",
    "\n",
    "    return pos\n",
    "\n",
    "\n",
    "if G.number_of_nodes() == 0:\n",
    "    print(\"Network graph is empty, so no plot was created.\")\n",
    "\n",
    "else:\n",
    "    labels = {node: clean_name(node) for node in G.nodes()}\n",
    "    pos = tier_layout(G)\n",
    "\n",
    "    node_colors = []\n",
