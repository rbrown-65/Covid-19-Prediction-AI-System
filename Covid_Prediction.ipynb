    "# PART N - BUILD NETWORK\n",
    "# =========================================================\n",
    "\n",
    "G = nx.DiGraph()\n",
    "\n",
    "# Parent variable -> direct PCR predictor, if parent models exist\n",
    "if len(markov_results) > 0:\n",
    "    for response_var, result in markov_results.items():\n",
